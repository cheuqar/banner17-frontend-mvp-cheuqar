# Smart Search UI Redesign Feature Flag
# Set to 'true' to enable Precision Monochrome redesign (Feature 001)
# Set to 'false' or remove to use original styling
VITE_SMART_SEARCH_V2_ENABLED=false

# Other environment variables
VITE_API_BASE_URL=http://localhost:8100
VITE_WS_BASE_URL=ws://localhost:8100

# BugSnag Error Monitoring
# Get API key from https://app.bugsnag.com/settings/<org>/<project>/notifier-api-key
VITE_BUGSNAG_API_KEY=your-bugsnag-api-key-here
VITE_APP_VERSION=1.0.0
# Set to 'true' to enable BugSnag in development/staging
VITE_ENABLE_BUGSNAG=false

# Build-time BugSnag API key (for source maps upload)
# Same as VITE_BUGSNAG_API_KEY, used during CI/CD builds
BUGSNAG_API_KEY=your-bugsnag-api-key-here
